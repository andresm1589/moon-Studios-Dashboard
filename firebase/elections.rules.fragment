        || (electoralParticipationOpen() && electoralManager() && resource.data.status in ['pending', 'approved', 'rejected'] && resource.data.votes == 0
          && get(/databases/$(database)/documents/elections/$(resource.data.electionId)).data.status == 'active'
          && request.time < get(/databases/$(database)/documents/elections/$(resource.data.electionId)).data.startDate
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy'])
          && request.resource.data.status in ['approved', 'rejected']
          && (request.resource.data.status == 'rejected' || electoralApprovedRight(resource.data.uid, resource.data.electionId, 'candidateStatus'))
