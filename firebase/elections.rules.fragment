        && validElectoralElection(next) && next.updatedAt == request.time
        && ((previous.status == 'draft' && previous.totalVotes == 0 && next.status in ['draft', 'active', 'archived']
            && changed.hasOnly(['name', 'description', 'registrationStartDate', 'registrationEndDate', 'startDate', 'endDate', 'positions', 'departments', 'status', 'updatedAt'])
            && (next.status != 'active' || next.endDate > request.time))
