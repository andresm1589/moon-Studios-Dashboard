            && (changed.hasOnly(['name', 'description', 'updatedAt'])
              || (previous.totalVotes == 0 && request.time < previous.startDate && request.time < next.startDate
                && changed.hasOnly(['name', 'description', 'registrationStartDate', 'registrationEndDate', 'startDate', 'endDate', 'updatedAt']))))
          || (previous.status == 'active' && next.status == 'closed' && changed.hasOnly(['status', 'updatedAt']))
          || (previous.status == 'closed' && next.status == 'archived' && changed.hasOnly(['status', 'updatedAt']))
          // Trash: keeps the previous status and who/when; votes and files stay intact.
          || (previous.status != 'deleted' && next.status == 'deleted' && next.get('previousStatus', '') == previous.status
            && next.get('deletedAt', null) == request.time && next.get('deletedBy', '') == request.auth.uid
            && changed.hasOnly(['status', 'previousStatus', 'deletedAt', 'deletedBy', 'updatedAt']))
          // Restore: always as archived, never reopened, without trash metadata.
          || (previous.status == 'deleted' && next.status == 'archived' && !next.keys().hasAny(['previousStatus', 'deletedAt', 'deletedBy'])
            && changed.hasOnly(['status', 'previousStatus', 'deletedAt', 'deletedBy', 'updatedAt'])));
    }
    match /elections/{electionId} {
      allow read, list: if electoralEnabled() && (electoralManager() || electoralPublished(resource.data));
      allow create: if electoralManager() && validElectoralElection(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'description', 'registrationStartDate', 'registrationEndDate', 'startDate', 'endDate', 'status', 'positions', 'departments', 'createdBy', 'createdAt', 'updatedAt', 'totalVotes'])
        && request.resource.data.keys().hasAll(['registrationStartDate', 'registrationEndDate'])
        && request.resource.data.status == 'draft' && request.resource.data.totalVotes == 0
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes']) && electoralAggregateUpdate(electionId, ''))
        || electoralManagerElectionUpdate();
      allow delete: if false;
    }
    match /electoralAccess/{accessId} {
      allow read, list: if electoralEnabled() && (electoralManager() || resource.data.uid == request.auth.uid);
      allow get: if electoralEnabled() && !exists(/databases/$(database)/documents/electoralAccess/$(accessId));
      allow create: if electoralAccessCreate(accessId);
      allow update: if electoralSelfAccessUpdate(accessId) || electoralReviewAccess(accessId);
      allow delete: if false;
    }
    match /electoralInvitations/{invitationId} {
