    match /electionResults/{resultId} {
      allow read, list: if electoralEnabled();
      allow create, update, delete: if false;
    }
    function validElectoralAnnouncement(value) {
      return value.keys().hasAll(['title', 'body', 'status', 'electionId', 'pinned', 'startsAt', 'endsAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && value.keys().hasOnly(['title', 'body', 'status', 'electionId', 'pinned', 'startsAt', 'endsAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && electoralText(value.title, 3, 160) && electoralText(value.body, 1, 4000)
        && value.status in ['draft', 'published', 'withdrawn'] && value.pinned is bool
        && electoralText(value.electionId, 0, 1500)
        && value.startsAt is timestamp && value.endsAt is timestamp && value.startsAt < value.endsAt
        && value.createdAt is timestamp && electoralText(value.createdBy, 1, 128)
        && value.updatedAt == request.time && value.updatedBy == request.auth.uid
        && (value.electionId == '' || (exists(/databases/$(database)/documents/elections/$(value.electionId))
          && get(/databases/$(database)/documents/elections/$(value.electionId)).data.status != 'deleted'
          && (value.status != 'published' || get(/databases/$(database)/documents/elections/$(value.electionId)).data.status != 'draft')));
    }
    match /electoralAnnouncements/{announcementId} {
      // Published notices also appear on the public closure/login screen.
      // Notices are withdrawn instead of deleted, so the history is preserved.
      allow get, list: if resource.data.status == 'published' || electoralManager();
      allow create: if electoralManager() && validElectoralAnnouncement(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if electoralManager() && validElectoralAnnouncement(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if false;
    }
    match /electoralSettings/{settingsId} {
      // The closure screen is shown before sign-in, so it is publicly readable.
      allow get: if settingsId == 'general';
      allow list: if false;
      allow create, update: if settingsId == 'general' && electoralManager()
        && request.resource.data.keys().hasOnly(['enabled', 'closureTitle', 'closureMessage', 'returnYear', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['enabled', 'closureTitle', 'closureMessage', 'returnYear', 'updatedAt', 'updatedBy'])
        && validElectoralSettingsContent(request.resource.data)
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /auditLogs/{logId} {
      allow read, list: if electoralManager();
      allow create: if electoralEnabled() && request.resource.data.keys().hasOnly(['action', 'userId', 'userName', 'details', 'timestamp'])
        && request.resource.data.userId == request.auth.uid && request.resource.data.timestamp == request.time
        && electoralText(request.resource.data.userName, 1, 160) && request.resource.data.details is map
        && ((electoralManager() && request.resource.data.action in ['ELECTION_CREATED', 'ELECTION_UPDATED', 'ELECTION_STATUS_CHANGED', 'CANDIDATE_APPROVED', 'CANDIDATE_REJECTED', 'CANDIDATE_DELETED', 'ELECTORAL_ACCESS_REVIEWED', 'INVITATION_CREATED', 'INVITATION_UPDATED', 'INVITATION_REVOKED', 'ELECTION_DELETED', 'ELECTION_RESTORED', 'ANNOUNCEMENT_CREATED', 'ANNOUNCEMENT_UPDATED', 'SETTINGS_UPDATED'])
          || request.resource.data.action in ['CANDIDATE_REGISTERED', 'ELECTORAL_ACCESS_REQUESTED', 'INVITATION_ACCEPTED']);
      allow update, delete: if false;
    }

